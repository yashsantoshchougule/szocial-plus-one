# Main Szocial project for authentication only.
SZOCIAL_AUTH_URL=
SZOCIAL_AUTH_PUBLISHABLE_KEY=

# Separate Plus One project. Use only this project's server key for private Storage.
PLUS_ONE_SUPABASE_URL=
PLUS_ONE_SUPABASE_SECRET_KEY=

# Canonical Main Szocial origin. Leave blank for the standalone local preview.
SZOCIAL_PUBLIC_ORIGIN=
NEXT_PUBLIC_APP_URL=

# Local admin credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only Razorpay credentials.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set to 1 to show fictional listings in the standalone local preview.
PLUS_ONE_DISCOVER_DEMO=

# Server-only connection for the dedicated plus_one_runtime role.
PLUS_ONE_DATABASE_URL=
DATABASE_URL=
